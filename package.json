{
	"name": "obsidian-plugin-template",
	"version": "0.0.0",
	"description": "Shared template for Obsidian plugins: CI, unit + real-Obsidian e2e tests, byte-reproducible demo screenshots.",
	"author": "rekby",
	"license": "AGPL-3.0-or-later",
	"keywords": [],
	"dependencies": {},
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"obsidian-tests": "npm run build && wdio run ./wdio.conf.mjs",
		"demo:capture": "npm run build && wdio run ./wdio.demo.conf.mjs",
		"demo:render": "node ./obsidian-tests/lib/render-demo.mjs",
		"demo": "npm run demo:capture && npm run demo:render"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@eslint/json": "^0.14.0",
		"@fontsource/inter": "^5.2.8",
		"@types/node": "^22.15.17",
		"@wdio/cli": "^9.26.1",
		"@wdio/globals": "^9.26.1",
		"@wdio/local-runner": "^9.26.1",
		"@wdio/mocha-framework": "^9.26.1",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"ffmpeg-static": "^5.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"obsidian-launcher": "^2.4.0",
		"oxipng-bin": "^1.0.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.2",
		"wdio-obsidian-reporter": "^2.4.0",
		"wdio-obsidian-service": "^2.4.0",
		"webdriverio": "^9.26.1"
	}
}
